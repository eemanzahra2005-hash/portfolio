# Web3Forms access key for the contact form (server-side only — never prefix with NEXT_PUBLIC_).
# Get one at https://web3forms.com and put it in .env.local.
WEB3FORMS_KEY=

# Public URL of the deployed site (no trailing slash), e.g. https://eemanzahra.vercel.app
# Used for canonical URLs, Open Graph images, sitemap.xml and robots.txt. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
